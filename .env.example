# Database
DATABASE_URL=postgresql://user:password@host:port/database?schema=public

# JWT
JWT_SECRET=your-secret-key-here

# Server
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-url.railway.app

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# WhatsApp Provider
WHATSAPP_PROVIDER=twilio
NOTIFICATIONS_ENABLED=true

# API URL (for media URLs and webhooks)
API_URL=https://inventaflowbackendcedin-production.up.railway.app

# SMTP (use a rotated credential; do not commit passwords)
SMTP_HOST=mail.inventa.com.py
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="InventaFlow System" <no-reply@inventa.com.py>

# Public origins and persistent upload path
PUBLIC_URL=https://inventaflowbackendcedin-production.up.railway.app
FRONTEND_URL=https://admin.cedin.com.py
UPLOAD_DIR=/app/public/uploads
